# Azure OpenAI (required for orchestrator and all agents)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Optional: Alpha Vantage (for additional fundamental/technical data)
# ALPHA_VANTAGE_API_KEY=

# Optional: Risk limits (used by Risk Management Agent)
# MAX_POSITION_PCT=10.0
# MAX_VOLATILITY_PCT=50.0

# Optional: Override default trading query when running main.py
# TRADING_QUERY=Give me a trading strategy for AAPL considering technicals, fundamentals, and risk.
